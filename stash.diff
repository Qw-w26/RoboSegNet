+
+    rp = torchsort.soft_rank(pred, regularization_strength=tau)
+    rq = torchsort.soft_rank(target, regularization_strength=tau)
+
+    rp = (rp - rp.mean(dim=-1, keepdim=True)) / (rp.std(dim=-1, keepdim=True) + 1e-8)
+    rq = (rq - rq.mean(dim=-1, keepdim=True)) / (rq.std(dim=-1, keepdim=True) + 1e-8)
+
+    corr = (rp * rq).mean(dim=-1)      # batchwise Pearson on soft ranks
+    return (1.0 - corr).mean()         # 0 best, 2 worst
