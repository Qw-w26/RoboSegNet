+class EnhancedMSELoss(nn.Module):
+    """
+    Enhanced Mean Squared Error loss with normalization and metric options.
+
+    Supports multiple distance metrics and optional normalization of predictions/targets.
+
+    Args:
+        normalize: Whether to normalize predictions and targets before computing loss.
+                   Options: 'normalized' (normalize to sum to 1), 'unnormalized' (no normalization)
+        metric: Distance metric to use. Options:
+                - 'mse': Standard mean squared error (default)
+                - 'spearman': Spearman rank correlation loss (1 - correlation)
+                - 'wasserstein': Wasserstein distance (Earth Mover's Distance)
+        reduction: Reduction method: 'mean', 'sum', or 'none'
+        epsilon: Small constant for numerical stability
+
+    Example:
+        >>> # Normalized MSE
+        >>> loss_fn = EnhancedMSELoss(normalize='normalized', metric='mse')
+        >>> # Unnormalized Spearman correlation loss
+        >>> loss_fn = EnhancedMSELoss(normalize='unnormalized', metric='spearman')
+        >>> # Normalized Wasserstein distance
+        >>> loss_fn = EnhancedMSELoss(normalize='normalized', metric='wasserstein')
+    """
+
+    def __init__(
+        self,
+        normalize: str = 'unnormalized',
+        metric: str = 'mse',
+        reduction: str = 'mean',
+        epsilon: float = 1e-8
+    ):
+        """
+        Initialize Enhanced MSE Loss.
+
+        Args:
+            normalize: 'normalized' or 'unnormalized'
+            metric: 'mse', 'spearman', or 'wasserstein'
+            reduction: 'mean', 'sum', or 'none'
+            epsilon: Small constant for numerical stability
+        """
+        super().__init__()
+
+        if normalize not in ['normalized', 'unnormalized']:
+            raise ValueError(f"normalize must be 'normalized' or 'unnormalized', got {normalize}")
+
+        if metric not in ['mse', 'spearman', 'wasserstein']:
+            raise ValueError(f"metric must be 'mse', 'spearman', or 'wasserstein', got {metric}")
+
+        self.normalize = normalize
+        self.metric = metric
+        self.reduction = reduction
+        self.epsilon = epsilon
+
+    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
+        """
+        Compute enhanced MSE loss.
+
+        Args:
+            logits: Model logits of shape (batch, window_size) or (batch, 2)
+            targets: Probability targets in [0, 1] of shape (batch, window_size)
+
+        Returns:
+            Scalar loss value (or tensor if reduction='none')
+        """
+        # Get predicted probability
+        if logits.ndim == 2 and logits.size(1) == 2:
+            probs = F.softmax(logits, dim=1)
+            pred_prob = probs[:, 1]
+        else:
+            pred_prob = torch.sigmoid(logits)
+
+        # Normalize if requested
+        if self.normalize == 'normalized':
+            # Normalize predictions to sum to 1
+            pred_sum = pred_prob.sum(dim=1, keepdim=True).clamp(min=self.epsilon)
+            pred_prob = pred_prob / pred_sum
+
+            # Normalize targets to sum to 1
+            target_sum = targets.sum(dim=1, keepdim=True).clamp(min=self.epsilon)
+            targets = targets / target_sum
+
+        # Compute loss based on metric
+        if self.metric == 'mse':
+            # Standard MSE
+            loss = (pred_prob - targets) ** 2
+            if self.reduction == 'mean':
+                return loss.mean()
+            elif self.reduction == 'sum':
+                return loss.sum()
+            else:
+                return loss.mean(dim=1)
+
+        elif self.metric == 'spearman':
+            # Differentiable Spearman rank loss
+            # Uses classical Spearman formula based on rank differences
+            loss = differentiable_spearman_loss(pred_prob, targets, epsilon=self.epsilon)
+
+            if self.reduction == 'mean':
+                return loss.mean()
+            elif self.reduction == 'sum':
+                return loss.sum()
+            else:
+                return loss
+
+        elif self.metric == 'wasserstein':
+            # Wasserstein distance (Earth Mover's Distance)
+            batch_losses = []
+            for i in range(pred_prob.size(0)):
+                pred_np = pred_prob[i].detach().cpu().numpy()
+                target_np = targets[i].detach().cpu().numpy()
+
+                # Create position arrays (indices)
+                positions = torch.arange(pred_prob.size(1), dtype=torch.float32).numpy()
+
+                # Compute Wasserstein distance
+                # This measures the minimum cost to transform one distribution to another
+                dist = wasserstein_distance(positions, positions, pred_np, target_np)
+                batch_losses.append(dist)
+
+            loss_tensor = torch.tensor(batch_losses, device=logits.device, dtype=logits.dtype)
+
+            if self.reduction == 'mean':
+                return loss_tensor.mean()
+            elif self.reduction == 'sum':
+                return loss_tensor.sum()
+            else:
+                return loss_tensor
+
+        # Should never reach here
+        raise RuntimeError(f"Unknown metric: {self.metric}")
+
+
